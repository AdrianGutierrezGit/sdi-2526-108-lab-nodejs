{% extends "layout.twig" %}

{% block title %} Detalles de canción {% endblock %}

{% block main_container %}
	<div class="row">
		<div class="media col-xs-10">
			<div class="media-left media-middle">
				<img class="media-object" src="/covers/{{ song._id }}.png">
			</div>
			<div class="media-body">
				<h2>{{ song.title }}</h2>
				<p>{{ song.author }}</p>
				<p>{{ song.kind }}</p>
				{% if canBuy %}
					<form class="form-horizontal" method="post" action="/songs/buy/{{ song._id }}">
						<button type="submit" class="btn btn-primary">
							Comprar: {{ song.price }} € - {{ song.usd }} $
						</button>
					</form>
				{% else %}
					<audio controls>
						<source src="/audios/{{ song._id }}.mp3" type="audio/mpeg">
						Tu navegador no soporta el elemento de audio.
					</audio>
				{% endif %}

			</div>
		</div>
	</div>

	<hr>

	<h4>Añadir comentario</h4>
	<form method="post" action="/comments/{{ song._id }}">
		<div class="form-group">
			<label for="text">Comentario</label>
			<textarea class="form-control" id="text" name="text" rows="3" required></textarea>
		</div>
		<button type="submit" class="btn btn-primary">Enviar comentario</button>
	</form>

	<h3>Comentarios</h3>
	{% if comments is empty %}
		<p>No hay comentarios todavía.</p>
	{% else %}
		<ul class="list-group">
			{% for comment in comments %}
				<li class="list-group-item">
					<strong>{{ comment.author }}</strong>: {{ comment.text }}
				</li>
			{% endfor %}
		</ul>
	{% endif %}

{% endblock %}