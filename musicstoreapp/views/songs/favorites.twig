{% extends "layout.twig" %}
{% block title %} Mis Favoritos {% endblock %}
{% block main_container %}
    <h2>Mis favoritos</h2>
    <div class="table-responsive">
        <table class="table table-striped">
            <thead>
            <tr>
                <th>Id</th>
                <th>Fecha</th>
                <th>Precio</th>
                <th>Titulo</th>
                <th>Usuario</th>
                <th></th>
            </tr>
            </thead>
            <tbody>
            {% for song in songs %}
                <tr>
                    <td>{{ song.songId }}</td>
                    <td>{{ song.date }}</td>
                    <td>{{ song.price }}</td>
                    <td>{{ song.title }}</td>
                    <td>{{ song.user }}</td>
                    <td>
                        <a href="/songs/favorites/delete/{{ song.songId }}">Eliminar de favoritos</a>
                    </td>
                </tr>
            {% endfor %}
            <tr>
                <td></td>
                <td><strong>Total:</strong></td>
                <td><strong>{{ totalPrice }}</strong></td>
                <td></td>
                <td></td>
                <td></td>
            </tr>
            </tbody>
        </table>

    </div>

{% endblock %}